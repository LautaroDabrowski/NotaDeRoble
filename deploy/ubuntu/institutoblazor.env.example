# Copiar a /etc/institutoblazor/institutoblazor.env y completar en la VM.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
ConnectionStrings__DefaultConnection="Server=127.0.0.1,1433;Database=InstitutoBlazorDemo;User Id=instituto_app;Password=REEMPLAZAR_EN_LA_VM;Encrypt=True;TrustServerCertificate=True;Connect Timeout=10"
Database__ApplyMigrations=true
DataProtection__KeysPath=/var/lib/institutoblazor/keys
AllowedHosts="localhost;127.0.0.1;REEMPLAZAR_CON_DOMINIO_O_IP_DE_LA_VM"
