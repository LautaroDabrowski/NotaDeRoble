<nav class="pagination-bar" aria-label="Paginación de empleados">
    <p class="mb-0" aria-live="polite">@Total registros · Página @PaginaActual de @TotalPaginas</p>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" disabled="@(Disabled || PaginaActual <= 1)" @onclick="() => OnCambio.InvokeAsync(PaginaActual - 1)">Anterior</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@(Disabled || PaginaActual >= TotalPaginas)" @onclick="() => OnCambio.InvokeAsync(PaginaActual + 1)">Siguiente</button>
    </div>
</nav>

@code {
    [Parameter] public int PaginaActual { get; set; } = 1;
    [Parameter] public int TotalPaginas { get; set; } = 1;
    [Parameter] public int Total { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<int> OnCambio { get; set; }
}
