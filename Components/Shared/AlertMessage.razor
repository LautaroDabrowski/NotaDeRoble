@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert alert-@Type alert-dismissible fade show" role="alert">
        @Message
        <button type="button" class="btn-close" aria-label="Cerrar mensaje" @onclick="Clear"></button>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public string Type { get; set; } = "warning";
    [Parameter] public EventCallback OnClosed { get; set; }
    private async Task Clear() => await OnClosed.InvokeAsync();
}
